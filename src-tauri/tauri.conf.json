{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "clipbuf",
  "version": "0.1.0",
  "identifier": "jp.gr.mac.iyas.clipbuf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "clipbuf",
        "visible": false,
        "width": 480,
        "height": 360,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/YasuhiroInagawa/clipbuf/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMTg0Q0ZDMjdCMURDQzUKUldURjNMRW4vRXdZYnRKdm9reGRnaGozNGtTaU8zVFVHaXd1TFBpSWVoMXdqSTBzOXlieWpncTAK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
